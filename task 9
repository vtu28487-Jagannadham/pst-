public class Main {

    public int add(int a, int b) {
        return a + b;
    }

    public int subtract(int a, int b) {
        return a - b;
    }

    public int multiply(int a, int b) {
        return a * b;
    }

    public double divide(int a, int b) {
        if (b == 0) {
            throw new IllegalArgumentException("Cannot divide by zero");
        }
        return (double) a / b;
    }

    public static void main(String[] args) {
        Main calc = new Main();

        // Testing methods
        System.out.println("Add Test (2 + 3): " + (calc.add(2, 3) == 5 ? "PASSED" : "FAILED"));
        System.out.println("Subtract Test (5 - 3): " + (calc.subtract(5, 3) == 2 ? "PASSED" : "FAILED"));
        System.out.println("Multiply Test (4 * 3): " + (calc.multiply(4, 3) == 12 ? "PASSED" : "FAILED"));
        System.out.println("Divide Test (5 / 2): " + (calc.divide(5, 2) == 2.5 ? "PASSED" : "FAILED"));
    }
}